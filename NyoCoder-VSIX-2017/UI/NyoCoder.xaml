<UserControl x:Class="NyoCoder.NyoCoderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NyoCoder"
             xmlns:vsfx="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             Name="NyoCoderWindow"
             Background="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowBackgroundKey}}">
    <UserControl.Resources>
        <!-- +/- toggle for collapsible thinking / tool-call blocks -->
        <Style x:Key="ThinkingExpandToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="9" Height="9"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    Margin="0,1,5,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Horizontal"
                                               Width="5" Height="1"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Rectangle x:Name="Vertical"
                                               Width="1" Height="5"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinkingExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="False">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource ThinkingExpandToggleStyle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Left"
                                          Padding="0"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              DockPanel.Dock="Top"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0"
                                              VerticalAlignment="Top"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Status bar showing token usage and step progress -->
        <Border x:Name="TokenStatusBar"
                Grid.Row="0"
                Background="{DynamicResource {x:Static vsfx:VsBrushes.CommandBarGradientBeginKey}}"
                Padding="6,3">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TokenStatusText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"
                               Text="Tokens: 0"/>
                    <!-- Cut short, not wrapped, when the window is narrow -->
                    <TextBlock x:Name="StepStatusText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"
                               Margin="12,0,0,0"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                    <!-- Opens the chat history panel. The icon is masked in code (LoadHistoryIcon)
                         and filled with the theme's text color. Sized in code (SizeHistoryButton):
                         a square a little taller than the token text, overhanging into the bar's
                         padding so the bar keeps its height, with the icon scaled to fill it. -->
                    <ToggleButton x:Name="HistoryButton"
                                  Grid.Column="2"
                                  Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  Focusable="False"
                                  AutomationProperties.Name="History"
                                  ToolTipService.ShowOnDisabled="True"
                                  Checked="HistoryButton_Checked"
                                  Unchecked="HistoryButton_Unchecked">
                        <Rectangle x:Name="HistoryIcon"
                                   Width="10"
                                   Height="10"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Fill="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"/>
                    </ToggleButton>
                </Grid>
                <Grid x:Name="SubagentStatusRow"
                      Margin="0,2,0,0"
                      Visibility="Collapsed">
                    <TextBlock x:Name="StepTokenStatusText"
                               Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Chat history: one ListBox item per output block -->
        <ListBox x:Name="ChatList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Padding="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch"
                 Foreground="{DynamicResource {x:Static vsfx:VsBrushes.WindowTextKey}}"
                 Background="{DynamicResource {x:Static vsfx:VsBrushes.WindowKey}}"
                 UseLayoutRounding="True"
                 SizeChanged="ChatList_SizeChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,14"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatTurn}">
                    <local:ChatTurnView Turn="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Button panel -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="176"
                      Margin="2"
                      Visibility="{Binding ElementName=ButtonPanel, Path=Visibility}">
            <StackPanel x:Name="ButtonPanel"
                        MinHeight="36"
                        Visibility="Collapsed"/>
        </ScrollViewer>

        <!-- Input bar (includes indexing status; hidden together when approval UI shows) -->
        <Border x:Name="InputBar"
                Grid.Row="3"
                Background="{DynamicResource {x:Static vsfx:VsBrushes.CommandBarGradientBeginKey}}"
                Padding="4">
            <StackPanel Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                Margin="0,0,4,0">
                        <Button x:Name="NewChatButton"
                                Content="New Chat"
                                MinWidth="72"
                                Padding="8,1"
                                Margin="0,0,0,4"
                                Click="NewChatButton_Click"/>
                        <ComboBox x:Name="ModeSelector"
                                  Width="72"/>
                    </StackPanel>
                    <TextBox x:Name="InputBox"
                             Grid.Column="1"
                             Margin="0,0,4,0"
                             MinHeight="48"
                             Height="48"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource {x:Static vsfx:VsBrushes.WindowKey}}"
                             Foreground="{DynamicResource {x:Static vsfx:VsBrushes.WindowTextKey}}"
                             CaretBrush="{DynamicResource {x:Static vsfx:VsBrushes.WindowTextKey}}"
                             PreviewKeyDown="InputBox_PreviewKeyDown"/>
                    <StackPanel Grid.Column="2"
                               Orientation="Vertical"
                               VerticalAlignment="Top">
                        <Button x:Name="InputSendButton"
                                Content="Send"
                                MinWidth="60"
                                MinHeight="20"
                                Padding="8,1"
                                Margin="0,0,0,4"
                                Click="InputSendButton_Click"/>
                        <ToggleButton x:Name="AttachImageButton"
                                Content="Attach Image"
                                MinWidth="60"
                                MinHeight="20"
                                Padding="8,1"
                                Checked="AttachImageButton_Checked"
                                Unchecked="AttachImageButton_Unchecked"/>
                    </StackPanel>
                </Grid>

                <!-- Indexing status (visible only when indexing mode != Off; hidden with InputBar) -->
                <Border x:Name="IndexingStatusBar"
                        Margin="2,4,2,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="IndexingStatusText"
                               Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"
                               TextTrimming="CharacterEllipsis"
                               Text="Index: idle"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Chat history: the workspace's saved chats, newest first, over the chat and input
             bar while open. Click or Enter opens one; right-click for Export and Delete. -->
        <DockPanel x:Name="HistoryPanel"
                   Grid.Row="1"
                   Grid.RowSpan="3"
                   Visibility="Collapsed"
                   Background="{DynamicResource {x:Static vsfx:VsBrushes.WindowKey}}"
                   PreviewKeyDown="HistoryPanel_PreviewKeyDown">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource {x:Static vsfx:VsBrushes.CommandBarGradientBeginKey}}"
                    Padding="6,3">
                <DockPanel>
                    <!-- Flat like the History button; negative margins keep the header
                         the same height as the tokens bar. -->
                    <Button DockPanel.Dock="Right"
                            Content="Close"
                            Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"
                            Margin="6,-2,0,-2"
                            Padding="6,0"
                            Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"
                            Click="HistoryCloseButton_Click"/>
                    <TextBlock Text="Chat History"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowTextKey}}"/>
                </DockPanel>
            </Border>
            <Grid>
                <ListBox x:Name="HistoryList"
                         BorderThickness="0"
                         Padding="2"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Foreground="{DynamicResource {x:Static vsfx:VsBrushes.WindowTextKey}}"
                         Background="{DynamicResource {x:Static vsfx:VsBrushes.WindowKey}}"
                         KeyDown="HistoryList_KeyDown"
                         ContextMenuOpening="HistoryList_ContextMenuOpening">
                    <!-- Items are added when it opens (see HistoryList_ContextMenuOpening). -->
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="ToolTip" Value="{Binding Title}"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="HistoryItem_MouseLeftButtonUp"/>
                            <!-- Own template: the theme's selection highlight fades when the list
                                 loses focus. The open chat (IsCurrent) is highlighted always;
                                 hover and the keyboard selection get a faint tint. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid SnapsToDevicePixels="True">
                                            <Border x:Name="Tint"
                                                    Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                    Opacity="0.2"
                                                    Visibility="Collapsed"/>
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyText"
                           Text="(empty)"
                           Margin="8"
                           TextWrapping="Wrap"
                           Opacity="0.65"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource {x:Static vsfx:VsBrushes.WindowTextKey}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
