<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NyoCoder</RootNamespace>
    <AssemblyName>NyoCoder-VSIX</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\NyoCoder-VSIX\Key.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <TargetVsixContainerName>NyoCoder-VSIX-2017+.vsix</TargetVsixContainerName>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="15.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.11.435" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Shared sources from the VS2010–2015 project (package + XAML are local to this project) -->
  <ItemGroup>
    <Compile Include="..\NyoCoder-VSIX\Core\**\*.cs" Exclude="..\NyoCoder-VSIX\Core\NyoCoder-VSIXPackage.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="Core\NyoCoder-VSIXPackage.cs" />
    <Compile Include="..\NyoCoder-VSIX\Editor\**\*.cs" Link="Editor\%(Filename)%(Extension)" />
    <Compile Include="..\NyoCoder-VSIX\Services\**\*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\NyoCoder-VSIX\Tools\**\*.cs" Link="Tools\%(Filename)%(Extension)" />
    <Compile Include="..\NyoCoder-VSIX\UI\**\*.cs" Exclude="..\NyoCoder-VSIX\UI\NyoCoder.xaml.cs" Link="UI\%(Filename)%(Extension)" />
    <Compile Include="..\NyoCoder-VSIX\UI\NyoCoder.xaml.cs" Link="UI\NyoCoder.xaml.cs">
      <DependentUpon>NyoCoder.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\NyoCoder-VSIX\Resources.Designer.cs" Link="Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="UI\NyoCoder.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\NyoCoder-VSIX\Resources.resx" Link="Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NyoCoder-VSIX\VSPackage.resx" Link="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="NyoCoder-VSIX-2017.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <SubType>Designer</SubType>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="..\NyoCoder-VSIX\Key.snk" Link="Key.snk" />
  </ItemGroup>

  <!-- VSCT bitmaps and package icon — linked from NyoCoder-VSIX (no local copies) -->
  <ItemGroup>
    <None Include="..\NyoCoder-VSIX\Resources\Images_24bit.bmp" Link="Resources\Images_24bit.bmp" />
    <None Include="..\NyoCoder-VSIX\Resources\Images_32bit.bmp" Link="Resources\Images_32bit.bmp" />
    <Content Include="..\NyoCoder-VSIX\Resources\Package.ico" Link="Resources\Package.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\LICENSE.rtf" Link="LICENSE.rtf">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\curl-ca-bundle.txt" Link="THIRD_PARTY_LICENSES\curl-ca-bundle.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\curl.txt" Link="THIRD_PARTY_LICENSES\curl.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\libidn2.txt" Link="THIRD_PARTY_LICENSES\libidn2.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\libpsl.txt" Link="THIRD_PARTY_LICENSES\libpsl.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\Newtonsoft.Json.txt" Link="THIRD_PARTY_LICENSES\Newtonsoft.Json.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\openssl.txt" Link="THIRD_PARTY_LICENSES\openssl.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD_PARTY_LICENSES\zlib.txt" Link="THIRD_PARTY_LICENSES\zlib.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- Native helpers: copy next to the assembly and pack into the VSIX -->
  <ItemGroup>
    <Content Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll" Condition="'$(PkgNewtonsoft_Json)' != ''">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Newtonsoft.Json.dll</Link>
      <VSIXSubPath>.</VSIXSubPath>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\curl.exe" Link="curl.exe">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\curl-ca-bundle.crt" Link="curl-ca-bundle.crt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\grep.exe" Link="grep.exe">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\libiconv2.dll" Link="libiconv2.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\libintl3.dll" Link="libintl3.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\pcre3.dll" Link="pcre3.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\NyoCoder-VSIX\Dependencies\regex2.dll" Link="regex2.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Must come after Sdk.targets so IntermediateOutputPath is set before VsSDK evaluates ResourceManifest. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != '' And Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
